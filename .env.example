# Copy to .env for local development. On Railway, set these in the dashboard.

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.railway.app

# ─── Database ────────────────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when you attach a Postgres service.
# Locally, leave blank to fall back to SQLite, or set to a postgres:// URL.
# DATABASE_URL=postgres://user:pass@host:5432/alluora
DB_SSLMODE=prefer

# ─── Bootstrap admin (the dashboard owner) ───────────────────────────────────
# These create / update the admin user on every deploy. Change BOOTSTRAP_ADMIN_PASSWORD
# in Railway and redeploy to rotate.
BOOTSTRAP_ADMIN_EMAIL=jeremiah@rudratech.sg
BOOTSTRAP_ADMIN_USERNAME=jeremiah
BOOTSTRAP_ADMIN_PASSWORD=set-a-strong-password-here

# ─── WordPress ───────────────────────────────────────────────────────────────
WORDPRESS_BASE_URL=https://staging.alluora.com

# ─── Bunny.net Stream ────────────────────────────────────────────────────────
# Get the library ID from the Bunny dashboard → Stream → your library.
# Get the API key from the same library's "API" tab (NOT the account-level key).
# CDN hostname is optional — if unset, the iframe.mediadelivery.net player is used.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# ─── CORS (mobile app + admin) ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:19006,https://staging.alluora.com

# ─── Storage (Railway volume mount) ──────────────────────────────────────────
# Set this to the volume mount path in Railway, e.g. /data
# Locally, leave unset to use ./media
# MEDIA_ROOT=/data/media

# ─── Workers ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
